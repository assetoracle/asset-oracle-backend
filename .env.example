NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

ASSET_CHAIN_RPC_URL=https://enugu-rpc.assetchain.org
ASSET_CHAIN_ID=42421
ASSET_CHAIN_EXPLORER_URL=https://scan-testnet.assetchain.org
# Leave blank until the new contract is deployed and independently verified.
ASSET_ORACLE_MARKET_MANAGER_ADDRESS=

# Owner wallet only: may review, approve, and reject proposals.
ADMIN_WALLET_ADDRESS=

# Comma-separated market creator wallets. These wallets may review and approve/reject normal and automated market proposals; they do not receive owner-only permissions.
MARKET_CREATOR_WALLET_ADDRESSES=0x8b8a6fb521d372c19a5ff913049475f4c8fb9459,0x96adb1c2ea8a816d68d27363a55e88b4c507691a
# Backend-only bearer secret for trusted automated market ingestion (minimum 32 random characters).
AUTOMATED_MARKET_INGEST_API_KEY=

# Backend-only provider secrets. Set real values in the hosting provider's secret settings, not in Git.
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
FRED_API_KEY=
SPORTMONKS_API_TOKEN=
API_FOOTBALL_API_KEY=
# Reserve for future official FireScreener API support; do not set/use until documented.
FIRE_SCREENER_API_KEY=

# Testnet-only proposal payments; disabled until token and treasury are independently verified.
ASSET_ORACLE_TESTNET_PAID_SUBMISSION_TREASURY_ADDRESS=
ASSET_ORACLE_TESTNET_RPC_URL=https://enugu-rpc.assetchain.org
ASSET_ORACLE_TESTNET_PAYMENT_CONFIRMATIONS=2
ASSET_ORACLE_PAID_SUBMISSIONS_TESTNET_ENABLED=false

# Full contract-independent Asset Chain indexer. Keep disabled until the start block and RPC are verified.
ASSET_CHAIN_INDEXER_ENABLED=false
ASSET_CHAIN_INDEXER_START_BLOCK=0
ASSET_CHAIN_INDEXER_POLL_MS=15000
ASSET_CHAIN_INDEXER_BLOCKS_PER_POLL=3
ASSET_CHAIN_INDEXER_CONFIRMATIONS=3
ASSET_CHAIN_INDEXER_REORG_DEPTH=12
# Use a strong random secret. IPs are HMAC-fingerprinted; raw IPs are not stored.
IP_FINGERPRINT_SECRET=

# Category-aware provider evidence worker. Keep disabled until a cron schedule is deliberately configured.
MARKET_EVIDENCE_WORKER_ENABLED=false
MARKET_EVIDENCE_MAX_PER_RUN=10
MARKET_EVIDENCE_INTERVAL_MINUTES=15
# Optional category-specific overrides (minutes).
MARKET_EVIDENCE_DIGITAL_ASSETS_INTERVAL_MINUTES=
# Legacy alias retained for existing deployments.
MARKET_EVIDENCE_CRYPTO_INTERVAL_MINUTES=
MARKET_EVIDENCE_RWA_INTERVAL_MINUTES=
MARKET_EVIDENCE_SPORTS_INTERVAL_MINUTES=
MARKET_EVIDENCE_ECONOMICS_INTERVAL_MINUTES=
MARKET_EVIDENCE_REGIONAL_INTERVAL_MINUTES=

# Automated market candidate generation (disabled unless explicitly enabled)
MARKET_PROPOSAL_GENERATOR_ENABLED=false
# Supply approved JSON templates through GitHub Actions secret; do not commit real templates or credentials.
MARKET_GENERATION_TEMPLATES_JSON=
