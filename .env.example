NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

ASSET_CHAIN_RPC_URL=https://enugu-rpc.assetchain.org
ASSET_CHAIN_ID=42421
ASSET_CHAIN_EXPLORER_URL=https://scan-testnet.assetchain.org

# Owner wallet only: may review, approve, and reject proposals.
ADMIN_WALLET_ADDRESS=

# Comma-separated market creator wallets. These wallets may review and approve/reject normal and automated market proposals; they do not receive owner-only permissions.
MARKET_CREATOR_WALLET_ADDRESSES=0x8b8a6fb521d372c19a5ff913049475f4c8fb9459,0x96adb1c2ea8a816d68d27363a55e88b4c507691a

# Testnet-only proposal payments; disabled until token and treasury are independently verified.
ASSET_ORACLE_TESTNET_PAID_SUBMISSION_TREASURY_ADDRESS=
ASSET_ORACLE_TESTNET_RPC_URL=https://enugu-rpc.assetchain.org
ASSET_ORACLE_TESTNET_PAYMENT_CONFIRMATIONS=2
ASSET_ORACLE_PAID_SUBMISSIONS_TESTNET_ENABLED=false

# Set only to the independently verified Enugu testnet manager address after read-only preflight passes.
# Do not reuse an old deployment address or enable the indexer before verifying contract bytecode and configuration.
ASSET_ORACLE_MARKET_MANAGER_ADDRESS=0x5fc327f55cf533ed5d05337f835be37ff1e0db1f
# Keep disabled until the verified manager address and deployment start block are confirmed.
ONCHAIN_STATS_INDEXER_ENABLED=false
# Use a strong random secret. IPs are HMAC-fingerprinted; raw IPs are not stored.
IP_FINGERPRINT_SECRET=
