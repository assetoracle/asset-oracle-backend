# Never commit a real private key or funded wallet secret.
DEPLOYER_PRIVATE_KEY=
ASSET_CHAIN_RPC_URL=https://enugu-rpc.assetchain.org
ASSET_CHAIN_EXPLORER_API_KEY=
ASSET_CHAIN_EXPLORER_API_URL=https://scan-testnet.assetchain.org/api

# Enugu testnet deployment supports USDC only. Mainnet token configuration is separate and must verify USDC, cNGN, and USDT addresses and decimals on-chain.
USDC_TOKEN_ADDRESS=0xc33741fddEBeA854d265db6F9707900Efb0211a2
USDC_TOKEN_DECIMALS=6

# Confirmed operational wallets. The deployer signer must be the owner wallet.
OWNER_WALLET_ADDRESS=0x3d3724d20d9d5db5a40819869057b37465a0c67d
TREASURY_ADDRESS=0x650fBE31b1710b27Ea9eBe03862BC93145Fb3d77
VALIDATOR_REWARD_POOL_ADDRESS=0xb86e97b85e816ed0fe170a2dc3b5558232792553
# For the initial testnet phase, use the owner wallet as the oracle resolver.
ORACLE_RESOLVER_ADDRESS=0x3d3724d20d9d5db5a40819869057b37465a0c67d
