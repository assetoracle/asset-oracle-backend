{
  "name": "asset-oracle-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Asset Oracle",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify:enugu-preflight": "tsx scripts/verify-enugu-paid-submission-preflight.ts",
    "automate:market-lifecycle": "node dist/workers/automateMarketLifecycle.js",
    "automate:market-evidence": "node dist/workers/marketEvidenceWorker.js",
    "automate:market-resolution-verification": "node dist/workers/marketResolutionVerificationWorker.js",
    "preflight:testnet-automation": "tsx scripts/testnet-automation-preflight.ts",
    "automate:market-proposals": "node dist/workers/marketProposalGeneratorWorker.js",
    "simulate:testnet-lifecycle": "tsx scripts/simulate-testnet-market-lifecycle.ts",
    "seed:legacy-publication-attempts": "tsx scripts/seed-legacy-market-publication-attempts.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.6.7",
    "viem": "^2.37.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3"
  }
}
